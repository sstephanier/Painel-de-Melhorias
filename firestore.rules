rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activeUser() {
      return profileExists() && profile().active == true;
    }

    function isAdmin() {
      return activeUser() && profile().role == 'admin';
    }

    function isEditor() {
      return activeUser() && (profile().role == 'editor' || profile().role == 'admin');
    }

    function canReadFrente(frente) {
      return activeUser() && (
        isAdmin() ||
        '*' in profile().areas ||
        frente in profile().areas
      );
    }

    // Perfil do usuário. No primeiro login ele pode criar apenas um perfil VIEWER.
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'viewer'
                    && request.resource.data.active == true
                    && request.resource.data.areas == ['*'];
      allow update, delete: if isAdmin();
    }

    // Processos: leitura por área; editor cria/edita; somente admin exclui.
    match /processos/{processoId} {
      allow read: if canReadFrente(resource.data.frente);
      allow create: if isEditor() && canReadFrente(request.resource.data.frente);
      allow update: if isEditor()
                    && canReadFrente(resource.data.frente)
                    && canReadFrente(request.resource.data.frente);
      allow delete: if isAdmin();
    }

    // Acompanhamentos também carregam o campo "frente" para permitir filtro seguro.
    match /acompanhamentos/{acompId} {
      allow read: if canReadFrente(resource.data.frente);
      allow create: if isEditor() && canReadFrente(request.resource.data.frente);
      allow update: if isEditor()
                    && canReadFrente(resource.data.frente)
                    && canReadFrente(request.resource.data.frente);
      allow delete: if isAdmin();
    }

    // Premissas e indicadores são visíveis aos usuários ativos; só admin altera.
    match /meta/parametros {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /meta/{document=**} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
  }
}
