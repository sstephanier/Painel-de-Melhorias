rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activeUser() {
      return profileExists() && profile().active == true;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches(".*stephanie.*@ufrn\\.edu\\.br")) ||
        (profileExists() && profile().role == 'admin')
      );
    }

    function isEditor() {
      return signedIn() && (isAdmin() || (activeUser() && (profile().role == 'editor' || profile().role == 'admin')));
    }

    function canReadFrente(frente) {
      return signedIn() && (
        isAdmin() ||
        (activeUser() && ('*' in profile().areas || frente in profile().areas))
      );
    }

    // Perfil do usuário
    match /usuarios/{uid} {
      allow read, write: if signedIn();
    }

    // Processos: leitura e escrita por usuários autenticados
    match /processos/{processoId} {
      allow read, write: if signedIn();
    }

    // Acompanhamentos
    match /acompanhamentos/{acompId} {
      allow read, write: if signedIn();
    }

    // Premissas e indicadores
    match /meta/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
